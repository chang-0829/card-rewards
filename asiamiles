<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>國泰亞萬鈦商卡 雙重活動記帳與回饋試算神器</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Vue 3 CDN -->
  <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
  <style>
    [v-cloak] { display: none; }
    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen">
  <div id="app" v-cloak class="pb-16">
    <!-- 頂部導覽標頭 -->
    <header class="bg-teal-900 text-white shadow-lg sticky top-0 z-30">
      <div class="max-w-7xl mx-auto px-4 py-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center gap-3">
        <div class="flex items-center space-x-3">
          <div class="bg-teal-700 p-2.5 rounded-xl shadow-inner border border-teal-500/30">
            <i class="fa-solid fa-plane-departure text-2xl text-amber-300"></i>
          </div>
          <div>
            <div class="flex items-center space-x-2">
              <h1 class="text-xl font-bold tracking-wide">亞萬鈦商卡 雙重活動記帳器</h1>
              <span class="bg-amber-400 text-teal-950 font-extrabold text-[11px] px-2 py-0.5 rounded-full uppercase shadow-sm">
                鈦商卡專用 (加速器$10/里)
              </span>
            </div>
            <p class="text-xs text-teal-200 mt-0.5">活動A (9月滿額加碼) ✕ 活動B (8月壽星2倍特店加碼)</p>
          </div>
        </div>

        <!-- 卡片資訊標籤 -->
        <div class="flex items-center space-x-2 text-xs bg-teal-950/70 border border-teal-700/60 px-3 py-2 rounded-xl text-teal-200">
          <i class="fa-solid fa-cake-candles text-purple-300"></i>
          <span>壽星月份：<strong class="text-white">8月</strong></span>
          <span class="text-teal-500">|</span>
          <span>一般消費：<strong class="text-white">$25/里</strong></span>
        </div>
      </div>

      <!-- 分頁頁籤 (Tabs) -->
      <div class="bg-teal-950/80 border-t border-teal-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex space-x-1 sm:space-x-4">
          <button @click="currentTab = 'progress'" 
                  :class="currentTab === 'progress' ? 'border-amber-400 text-amber-300 bg-teal-900/60' : 'border-transparent text-teal-200 hover:text-white hover:bg-teal-900/30'"
                  class="py-3 px-4 font-bold text-xs sm:text-sm border-b-2 transition flex items-center space-x-2">
            <i class="fa-solid fa-chart-line"></i>
            <span>累積進度</span>
          </button>

          <button @click="currentTab = 'ledger'" 
                  :class="currentTab === 'ledger' ? 'border-amber-400 text-amber-300 bg-teal-900/60' : 'border-transparent text-teal-200 hover:text-white hover:bg-teal-900/30'"
                  class="py-3 px-4 font-bold text-xs sm:text-sm border-b-2 transition flex items-center space-x-2">
            <i class="fa-solid fa-receipt"></i>
            <span>記帳頁面</span>
            <span class="bg-teal-700 text-teal-100 text-[10px] px-1.5 py-0.2 rounded-full">{{ transactions.length }}</span>
          </button>

          <button @click="currentTab = 'details'" 
                  :class="currentTab === 'details' ? 'border-amber-400 text-amber-300 bg-teal-900/60' : 'border-transparent text-teal-200 hover:text-white hover:bg-teal-900/30'"
                  class="py-3 px-4 font-bold text-xs sm:text-sm border-b-2 transition flex items-center space-x-2">
            <i class="fa-solid fa-circle-info"></i>
            <span>活動說明</span>
          </button>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">

      <!-- ================= 頁籤 1：累積進度 (Progress) ================= -->
      <div v-if="currentTab === 'progress'" class="space-y-6">
        <!-- 總哩程預估 Hero 卡片 -->
        <div class="bg-gradient-to-br from-teal-800 via-teal-900 to-slate-900 rounded-3xl p-6 text-white shadow-xl relative overflow-hidden border border-teal-700/40">
          <div class="absolute -right-6 -bottom-8 text-teal-600/15 text-9xl pointer-events-none">
            <i class="fa-solid fa-plane"></i>
          </div>
          
          <div class="relative z-10 grid grid-cols-1 lg:grid-cols-3 gap-6 items-center">
            <div class="lg:col-span-2 space-y-2">
              <div class="inline-flex items-center space-x-2 bg-amber-400/20 text-amber-300 text-xs px-3 py-1 rounded-full border border-amber-400/30">
                <i class="fa-solid fa-sparkles"></i>
                <span>雙重活動加碼總試算</span>
              </div>
              <div class="text-4xl sm:text-5xl font-extrabold text-amber-300 tracking-tight">
                {{ formatNum(totalMiles) }} <span class="text-xl font-normal text-teal-200">里</span>
              </div>
              <p class="text-xs text-teal-200/90 leading-relaxed">
                包含鈦商卡基礎/加速器回饋 <strong class="text-white">{{ formatNum(baseMilesTotal) }} 里</strong>，以及雙重活動加碼合計 <strong class="text-amber-300">{{ formatNum(activityAMiles + activityBMiles) }} 里</strong>。
              </p>
            </div>

            <!-- 右側星巴克解鎖與極速資訊 -->
            <div class="bg-teal-950/60 p-4 rounded-2xl border border-teal-800/80 space-y-3">
              <div class="flex items-center justify-between text-xs border-b border-teal-800/80 pb-2">
                <span class="text-teal-300">活動A 好禮二 (星巴克飲品券)</span>
                <i class="fa-solid fa-mug-hot text-amber-400"></i>
              </div>
              <div v-if="starbucksQualified" class="flex items-center space-x-2 text-emerald-400 text-xs font-bold bg-emerald-950/50 p-2.5 rounded-xl border border-emerald-800/40">
                <i class="fa-solid fa-circle-check text-base"></i>
                <span>符合資格！發送 30元+50元 飲品券各乙張</span>
              </div>
              <div v-else class="text-xs text-teal-300/70 bg-teal-900/40 p-2.5 rounded-xl flex justify-between items-center border border-teal-800/40">
                <span>國內或海外消費滿 $30,000 解鎖</span>
                <i class="fa-solid fa-lock text-teal-400"></i>
              </div>
            </div>
          </div>
        </div>

        <!-- 雙活動累積與門檻進度圖表 -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          
          <!-- 活動A：9月滿額贈加碼進度卡 -->
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-5">
            <div class="flex justify-between items-start border-b pb-3 border-slate-100">
              <div>
                <h3 class="font-bold text-slate-800 text-base flex items-center space-x-2">
                  <span class="w-3 h-3 bg-amber-500 rounded-full inline-block"></span>
                  <span>活動A：9月滿額額外加碼</span>
                </h3>
                <p class="text-xs text-slate-500 mt-0.5">國內/海外一般消費每滿 $30,000 贈哩（上限 4,000 里）</p>
              </div>
              <span class="text-xs bg-amber-50 text-amber-700 font-bold px-2.5 py-1 rounded-lg border border-amber-200">
                已獲 +{{ formatNum(activityAMiles) }} 里
              </span>
            </div>

            <!-- 海外累積與計算 -->
            <div class="space-y-2">
              <div class="flex justify-between text-xs font-bold text-slate-700">
                <span class="flex items-center">
                  <i class="fa-solid fa-globe text-blue-500 mr-1.5"></i>海外一般消費總額
                </span>
                <span class="text-blue-600">NT$ {{ formatNum(overseasValidTotal) }}</span>
              </div>
              <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden">
                <div class="bg-blue-500 h-full transition-all duration-300" :style="{ width: Math.min(100, (overseasValidTotal / 120000) * 100) + '%' }"></div>
              </div>
              <div class="flex justify-between text-[11px] text-slate-500">
                <span>門檻：每滿 $30,000 贈 1,000 里 (優先計算)</span>
                <span class="font-bold text-slate-700">合規 {{ overseasSteps }} 組 (+{{ overseasSteps * 1000 }}里)</span>
              </div>
            </div>

            <!-- 國內累積與計算 -->
            <div class="space-y-2 pt-2 border-t border-slate-100">
              <div class="flex justify-between text-xs font-bold text-slate-700">
                <span class="flex items-center">
                  <i class="fa-solid fa-house-flag text-teal-600 mr-1.5"></i>國內一般消費總額
                </span>
                <span class="text-teal-700">NT$ {{ formatNum(domesticValidTotal) }}</span>
              </div>
              <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden">
                <div class="bg-teal-600 h-full transition-all duration-300" :style="{ width: Math.min(100, (domesticValidTotal / 240000) * 100) + '%' }"></div>
              </div>
              <div class="flex justify-between text-[11px] text-slate-500">
                <span>門檻：每滿 $30,000 贈 500 里 (剩餘額度計算)</span>
                <span class="font-bold text-slate-700">合規 {{ domesticSteps }} 組 (+{{ domesticSteps * 500 }}里)</span>
              </div>
            </div>

            <!-- 活動A 上限進度條 -->
            <div class="bg-slate-50 p-3.5 rounded-xl space-y-2 border border-slate-100">
              <div class="flex justify-between text-xs font-bold">
                <span class="text-slate-600">活動A 總加碼上限進度 (4,000 里)</span>
                <span class="text-amber-600">{{ ((activityAMiles / 4000) * 100).toFixed(0) }}%</span>
              </div>
              <div class="w-full bg-slate-200 h-3 rounded-full overflow-hidden">
                <div class="bg-gradient-to-r from-amber-400 to-amber-500 h-full transition-all duration-300" :style="{ width: (activityAMiles / 4000) * 100 + '%' }"></div>
              </div>
            </div>
          </div>

          <!-- 活動B：8月生日月特店2倍加碼卡 -->
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-5">
            <div class="flex justify-between items-start border-b pb-3 border-slate-100">
              <div>
                <h3 class="font-bold text-slate-800 text-base flex items-center space-x-2">
                  <span class="w-3 h-3 bg-purple-600 rounded-full inline-block"></span>
                  <span>活動B：8月生日月哩程加速器2倍</span>
                </h3>
                <p class="text-xs text-slate-500 mt-0.5">8月於指定「哩程加速器」消費享額外1倍加碼（上限 5,000 里）</p>
              </div>
              <span class="text-xs bg-purple-50 text-purple-700 font-bold px-2.5 py-1 rounded-lg border border-purple-200">
                已獲 +{{ formatNum(activityBMiles) }} 里
              </span>
            </div>

            <div class="bg-purple-50/50 p-4 rounded-xl space-y-3 border border-purple-100">
              <div class="flex justify-between text-xs font-bold text-slate-700">
                <span>8月生日月加速器消費合規總額</span>
                <span class="text-purple-700 font-mono text-sm">NT$ {{ formatNum(augustAcceleratorTotal) }}</span>
              </div>
              <div class="text-xs text-slate-600 leading-relaxed">
                鈦商卡加速器原回饋：<strong class="text-purple-800">$10 = 1 里</strong><br>
                生日月額外加碼：<strong class="text-purple-800">額外贈 1 倍里數</strong> (相當於 $5/里 優惠效果)
              </div>
            </div>

            <!-- 活動B 上限進度條 -->
            <div class="space-y-2">
              <div class="flex justify-between text-xs font-bold">
                <span class="text-slate-600">生日加碼最高上限 (5,000 里)</span>
                <span class="text-purple-700">{{ ((activityBMiles / 5000) * 100).toFixed(0) }}%</span>
              </div>
              <div class="w-full bg-slate-100 h-3 rounded-full overflow-hidden">
                <div class="bg-gradient-to-r from-purple-500 to-indigo-600 h-full transition-all duration-300" :style="{ width: (activityBMiles / 5000) * 100 + '%' }"></div>
              </div>
              <p class="text-[11px] text-slate-400">當在8月壽星月於加速器消費滿 NT$ 50,000，即可領滿 5,000 里加碼！</p>
            </div>
          </div>

        </div>
      </div>

      <!-- ================= 頁籤 2：記帳頁面 (Ledger) ================= -->
      <div v-if="currentTab === 'ledger'" class="space-y-6">
        
        <!-- 工具列與新增按鈕 -->
        <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs font-bold text-slate-500 mr-1">篩選檢視：</span>
            <button @click="filter = 'all'" 
                    :class="filter === 'all' ? 'bg-slate-800 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'" 
                    class="px-3 py-1.5 rounded-lg text-xs font-medium transition">
              全部紀錄
            </button>
            <button @click="filter = 'august'" 
                    :class="filter === 'august' ? 'bg-purple-600 text-white' : 'bg-purple-50 text-purple-700 hover:bg-purple-100'" 
                    class="px-3 py-1.5 rounded-lg text-xs font-medium transition">
              8月生日月
            </button>
            <button @click="filter = 'actA'" 
                    :class="filter === 'actA' ? 'bg-amber-600 text-white' : 'bg-amber-50 text-amber-700 hover:bg-amber-100'" 
                    class="px-3 py-1.5 rounded-lg text-xs font-medium transition">
              活動A滿額採計
            </button>
            <button @click="filter = 'invalid'" 
                    :class="filter === 'invalid' ? 'bg-rose-600 text-white' : 'bg-rose-50 text-rose-700 hover:bg-rose-100'" 
                    class="px-3 py-1.5 rounded-lg text-xs font-medium transition">
              無效/警告紀錄
            </button>
          </div>

          <div class="flex items-center space-x-2 w-full sm:w-auto">
            <button @click="openAddModal" class="flex-1 sm:flex-none px-4 py-2 bg-teal-700 hover:bg-teal-800 text-white rounded-xl text-xs font-bold transition shadow-sm flex items-center justify-center space-x-2">
              <i class="fa-solid fa-plus"></i>
              <span>新增消費紀錄</span>
            </button>
            <button v-if="transactions.length > 0" @click="clearAllTx" class="px-3 py-2 bg-slate-100 hover:bg-rose-50 text-slate-500 hover:text-rose-600 rounded-xl text-xs transition border border-slate-200" title="清空全部資料">
              <i class="fa-solid fa-trash-can"></i>
            </button>
          </div>
        </div>

        <!-- 記帳表格 -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
          <div class="overflow-x-auto custom-scrollbar">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-slate-50 text-slate-500 text-xs font-semibold uppercase tracking-wider border-b border-slate-100">
                  <th class="py-3.5 px-4">消費日期</th>
                  <th class="py-3.5 px-4">消費通路 / 商店名稱</th>
                  <th class="py-3.5 px-4">金額 (NT$)</th>
                  <th class="py-3.5 px-4">支付方式 / 資格</th>
                  <th class="py-3.5 px-4 text-center">鈦商卡基礎/加速</th>
                  <th class="py-3.5 px-4 text-center">活動A (滿額)</th>
                  <th class="py-3.5 px-4 text-center">活動B (8月生日)</th>
                  <th class="py-3.5 px-4 text-right">操作</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 text-xs text-slate-700">
                <tr v-for="tx in filteredTransactions" :key="tx.id" class="hover:bg-slate-50/80 transition-colors">
                  <!-- 日期 -->
                  <td class="py-3.5 px-4 font-mono font-medium text-slate-600">
                    {{ tx.date }}
                    <span v-if="isAugust(tx.date)" class="ml-1 px-1.5 py-0.2 bg-purple-100 text-purple-700 rounded text-[10px] font-bold">8月</span>
                  </td>
                  
                  <!-- 商店名稱與標籤 -->
                  <td class="py-3.5 px-4">
                    <div class="font-bold text-slate-800">{{ tx.merchant }}</div>
                    <div class="flex flex-wrap gap-1 mt-1">
                      <span v-if="tx.isOverseas" class="px-1.5 py-0.5 bg-blue-50 text-blue-600 border border-blue-200 rounded text-[10px]">海外消費</span>
                      <span v-else class="px-1.5 py-0.5 bg-slate-100 text-slate-600 rounded text-[10px]">國內消費</span>
                      
                      <span v-if="tx.isAccelerator" class="px-1.5 py-0.5 bg-amber-50 text-amber-700 border border-amber-200 rounded text-[10px] font-medium">
                        <i class="fa-solid fa-bolt text-amber-500 mr-0.5"></i>哩程加速器 ($10/里)
                      </span>
                      <span v-else class="px-1.5 py-0.5 bg-slate-100 text-slate-500 rounded text-[10px]">一般消費 ($25/里)</span>
                    </div>
                  </td>

                  <!-- 金額 -->
                  <td class="py-3.5 px-4 font-mono font-bold text-slate-800">
                    ${{ formatNum(tx.amount) }}
                  </td>

                  <!-- 支付方式與狀態警告 -->
                  <td class="py-3.5 px-4">
                    <div class="flex items-center space-x-1 font-medium" :class="tx.isValidPayment ? 'text-slate-700' : 'text-rose-600 font-bold'">
                      <i v-if="!tx.isValidPayment" class="fa-solid fa-triangle-exclamation text-rose-500"></i>
                      <span>{{ getPaymentLabel(tx.paymentMethod) }}</span>
                    </div>
                    <div v-if="!tx.isValidPayment" class="text-[10px] text-rose-500 mt-0.5 font-bold">排除項/不享有里數</div>
                  </td>

                  <!-- 基礎/加速哩程 -->
                  <td class="py-3.5 px-4 text-center font-mono font-bold">
                    <span v-if="tx.isValidPayment" class="text-teal-700">+{{ formatNum(calcBaseMiles(tx)) }} 里</span>
                    <span v-else class="text-slate-300">0</span>
                  </td>

                  <!-- 活動A標籤 -->
                  <td class="py-3.5 px-4 text-center">
                    <span v-if="tx.isValidPayment" class="inline-block px-2 py-0.5 bg-amber-50 text-amber-700 rounded font-medium text-[11px]">
                      採計 NT${{ formatNum(tx.amount) }}
                    </span>
                    <span v-else class="text-slate-300">-</span>
                  </td>

                  <!-- 活動B標籤 -->
                  <td class="py-3.5 px-4 text-center font-mono">
                    <span v-if="isAugust(tx.date) && tx.isAccelerator && tx.isValidPayment" class="text-purple-700 font-bold">
                      +{{ formatNum(calcBaseMiles(tx)) }} 里
                    </span>
                    <span v-else class="text-slate-300">-</span>
                  </td>

                  <!-- 操作 -->
                  <td class="py-3.5 px-4 text-right space-x-2">
                    <button @click="editTx(tx)" class="text-slate-400 hover:text-slate-600">
                      <i class="fa-solid fa-pen"></i>
                    </button>
                    <button @click="deleteTx(tx.id)" class="text-slate-400 hover:text-rose-600">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </td>
                </tr>
                <tr v-if="filteredTransactions.length === 0">
                  <td colspan="8" class="text-center py-12 text-slate-400">
                    <i class="fa-solid fa-folder-open text-4xl mb-3 block text-slate-300"></i>
                    尚無筆記紀錄，請點擊「新增消費紀錄」開始記帳
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ================= 頁籤 3：活動說明 (Details) ================= -->
      <div v-if="currentTab === 'details'" class="space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          
          <!-- 活動 A 詳細說明 -->
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-4">
            <div class="border-b pb-3 border-slate-100">
              <span class="text-xs bg-amber-100 text-amber-800 font-bold px-2 py-0.5 rounded">登錄制</span>
              <h3 class="font-bold text-slate-800 text-lg mt-1">活動A：滿額加碼最高送 4,000 里 + 星巴克</h3>
            </div>
            
            <ul class="text-xs text-slate-600 space-y-3 leading-relaxed">
              <li class="flex items-start space-x-2">
                <i class="fa-solid fa-calendar text-amber-500 mt-0.5"></i>
                <span><strong>登錄時間：</strong> 2026/9/21 16:00 至 2026/9/30 23:59 (本行官網或國泰優惠 App)。</span>
              </li>
              <li class="flex items-start space-x-2">
                <i class="fa-solid fa-credit-card text-amber-500 mt-0.5"></i>
                <span><strong>請款期限：</strong> 刷卡消費最晚需於 2026/10/9 前請款入帳。正附卡消費歸戶合併計算。</span>
              </li>
              <li class="flex items-start space-x-2">
                <i class="fa-solid fa-gift text-amber-500 mt-0.5"></i>
                <div>
                  <strong>好禮一 (額外里數最高 4,000 里)：</strong>
                  <ul class="list-disc pl-4 mt-1 space-y-1">
                    <li>海外一般消費：每累計刷達 NT$30,000 贈額外 <strong>1,000 里</strong>。</li>
                    <li>國內一般消費：每累計刷達 NT$30,000 贈額外 <strong>500 里</strong>。</li>
                    <li>計算優先順序：<strong>優先計算海外消費達檻</strong>，再計算國內消費達檻。</li>
                  </ul>
                </div>
              </li>
              <li class="flex items-start space-x-2">
                <i class="fa-solid fa-mug-hot text-amber-500 mt-0.5"></i>
                <span><strong>好禮二 (星巴克飲品券)：</strong> 活動期間國內或海外一般消費累計刷達 NT$30,000(含)以上(擇一符合)，即贈星巴克「30元飲品優惠券*1張 + 50元飲品優惠券*1張」電子券 (每正卡人限乙份)。</span>
              </li>
            </ul>
          </div>

          <!-- 活動 B 詳細說明 -->
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-4">
            <div class="border-b pb-3 border-slate-100">
              <span class="text-xs bg-purple-100 text-purple-800 font-bold px-2 py-0.5 rounded">壽星專屬</span>
              <h3 class="font-bold text-slate-800 text-lg mt-1">活動B：8月生日當月指定消費 2倍里數</h3>
            </div>

            <ul class="text-xs text-slate-600 space-y-3 leading-relaxed">
              <li class="flex items-start space-x-2">
                <i class="fa-solid fa-cake-candles text-purple-600 mt-0.5"></i>
                <span><strong>資格：</strong> 亞洲萬里通聯名卡正卡持卡人，於<strong>生日當月(8月)</strong>於「哩程加速器」特店消費。</span>
              </li>
              <li class="flex items-start space-x-2">
                <i class="fa-solid fa-bolt text-purple-600 mt-0.5"></i>
                <span><strong>回饋內容：</strong> 享里數 2倍 回饋 (鈦商卡原 NT$10=1里，額外再加碼1倍里數，相當於 NT$5 = 1里)。</span>
              </li>
              <li class="flex items-start space-x-2">
                <i class="fa-solid fa-hand-holding-dollar text-purple-600 mt-0.5"></i>
                <span><strong>生日禮加碼上限：</strong> 生日當月最高可獲得額外 <strong>5,000 里數</strong>（與每月哩程加速器原本的回饋上限分開獨立計算）。</span>
              </li>
              <li class="flex items-start space-x-2">
                <i class="fa-solid fa-clock text-purple-600 mt-0.5"></i>
                <span><strong>請款時間：</strong> 商家需於持卡人生日之次月 15 日前 (9/15前) 完成請款方可計入。</span>
              </li>
            </ul>
          </div>

        </div>

        <!-- 哩程加速器特店與無效刷卡排查區 -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- 哩程加速器指定商店列表 -->
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-3">
            <h4 class="font-bold text-slate-800 text-sm flex items-center space-x-2 border-b pb-2">
              <i class="fa-solid fa-bolt text-amber-500"></i>
              <span>哩程加速器指定商店分類參考</span>
            </h4>
            <div class="grid grid-cols-2 gap-2 text-xs text-slate-600">
              <div class="bg-slate-50 p-2.5 rounded-lg">
                <strong class="text-slate-800 block mb-1">✈️ 航空公司 & 旅遊平台</strong>
                國泰航空官網、Klook、KKday、易游網、雄獅旅遊
              </div>
              <div class="bg-slate-50 p-2.5 rounded-lg">
                <strong class="text-slate-800 block mb-1">🏨 飯店住宿 & 免稅店</strong>
                Agoda、Booking.com、昇恆昌免稅店、采盟免稅店
              </div>
              <div class="bg-slate-50 p-2.5 rounded-lg">
                <strong class="text-slate-800 block mb-1">🛍️ 國內指定百貨/租車</strong>
                遠東SOGO、和運租車、格上租車
              </div>
              <div class="bg-slate-50 p-2.5 rounded-lg">
                <strong class="text-slate-800 block mb-1">🌏 海外消費</strong>
                海外實體商店實體刷卡消費（非新臺幣交易）
              </div>
            </div>
          </div>

          <!-- 排除項目與注意事項 -->
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-3">
            <h4 class="font-bold text-rose-700 text-sm flex items-center space-x-2 border-b pb-2">
              <i class="fa-solid fa-triangle-exclamation text-rose-500"></i>
              <span>完全無哩程回饋之排除項目（請務必避開）</span>
            </h4>
            <ul class="text-xs text-slate-600 space-y-2 leading-relaxed">
              <li class="flex items-start space-x-1.5">
                <span class="text-rose-500 font-bold">❌</span>
                <span><strong>第三方/電子支付綁卡：</strong>LINE Pay、街口支付、全支付、PX Pay、悠遊付等電子錢包綁定消費（不論通路均零回饋）。</span>
              </li>
              <li class="flex items-start space-x-1.5">
                <span class="text-rose-500 font-bold">❌</span>
                <span><strong>便利超商與全聯：</strong>7-11、全家實體與線上門市、全聯福利中心、小額支付平台特店。</span>
              </li>
              <li class="flex items-start space-x-1.5">
                <span class="text-rose-500 font-bold">❌</span>
                <span><strong>規費與公用事業：</strong>水電瓦斯、路邊停車、學費、各類稅款、保費、悠遊卡/一卡通自動加值。</span>
              </li>
              <li class="flex items-start space-x-1.5">
                <span class="text-emerald-600 font-bold">✅</span>
                <span><strong>認證符合回饋：</strong>直接使用實體卡、Apple Pay、Google Pay、Samsung Pay 感應支付。</span>
              </li>
            </ul>
          </div>
        </div>

      </div>

    </main>

    <!-- 新增/編輯消費 Modal -->
    <div v-if="showModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-xl space-y-4">
        <div class="flex justify-between items-center border-b pb-3 border-slate-100">
          <h3 class="font-bold text-slate-800 text-base">
            {{ isEditing ? '編輯消費紀錄' : '新增消費簽帳紀錄' }}
          </h3>
          <button @click="closeModal" class="text-slate-400 hover:text-slate-600">
            <i class="fa-solid fa-xmark text-lg"></i>
          </button>
        </div>

        <form @submit.prevent="saveTx" class="space-y-4 text-xs">
          <!-- 消費日期與金額 -->
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block font-semibold text-slate-700 mb-1">消費日期 *</label>
              <input type="date" v-model="form.date" required class="w-full border border-slate-300 rounded-lg p-2 focus:ring-2 focus:ring-teal-500 focus:outline-none">
            </div>
            <div>
              <label class="block font-semibold text-slate-700 mb-1">消費金額 (NT$) *</label>
              <input type="number" min="1" v-model.number="form.amount" required placeholder="如 30000" class="w-full border border-slate-300 rounded-lg p-2 focus:ring-2 focus:ring-teal-500 focus:outline-none">
            </div>
          </div>

          <!-- 通路商店名稱 -->
          <div>
            <label class="block font-semibold text-slate-700 mb-1">商店 / 通路名稱 *</label>
            <input type="text" v-model="form.merchant" required placeholder="如：國泰航空官網預訂、Klook、日本免稅店" class="w-full border border-slate-300 rounded-lg p-2 focus:ring-2 focus:ring-teal-500 focus:outline-none">
          </div>

          <!-- 區域與哩程加速器標籤 -->
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block font-semibold text-slate-700 mb-1">交易區域</label>
              <select v-model="form.isOverseas" class="w-full border border-slate-300 rounded-lg p-2 focus:ring-2 focus:ring-teal-500 focus:outline-none">
                <option :value="false">國內消費 (新臺幣交易)</option>
                <option :value="true">海外消費 (外幣或海外登記商戶)</option>
              </select>
            </div>
            <div>
              <label class="block font-semibold text-slate-700 mb-1">哩程加速器特店？</label>
              <select v-model="form.isAccelerator" class="w-full border border-slate-300 rounded-lg p-2 focus:ring-2 focus:ring-teal-500 focus:outline-none">
                <option :value="true">是 ($10/里，8月享生日2倍)</option>
                <option :value="false">否 ($25/里 一般消費)</option>
              </select>
            </div>
          </div>

          <!-- 支付方式 -->
          <div>
            <label class="block font-semibold text-slate-700 mb-1">支付方式 *</label>
            <select v-model="form.paymentMethod" class="w-full border border-slate-300 rounded-lg p-2 focus:ring-2 focus:ring-teal-500 focus:outline-none">
              <optgroup label="✅ 符合回饋資格">
                <option value="physical">實體卡刷卡</option>
                <option value="apple_pay">Apple Pay</option>
                <option value="google_pay">Google Pay</option>
                <option value="samsung_pay">Samsung Pay</option>
              </optgroup>
              <optgroup label="❌ 不符合回饋 (警告)">
                <option value="line_pay">LINE Pay 綁定</option>
                <option value="jko_pay">街口支付 / 電子支付</option>
                <option value="px_pay">全支付 / PX Pay (全聯)</option>
                <option value="convenience">便利超商 (7-11/全家)</option>
                <option value="excluded_bills">公務機關 / 水電 / 稅款 / 學費</option>
              </optgroup>
            </select>
          </div>

          <!-- 警告提示 -->
          <div v-if="!isPaymentValid(form.paymentMethod)" class="p-3 bg-rose-50 border border-rose-200 rounded-xl text-rose-700 flex items-start space-x-2">
            <i class="fa-solid fa-triangle-exclamation text-rose-500 mt-0.5"></i>
            <div>
              <strong>警示：此支付方式無任何哩程！</strong>
              <p class="text-[11px] mt-0.5">活動條款已列明：卡片綁定第三方支付或於便利超商/全聯消費將被排除於一般消費之外。</p>
            </div>
          </div>

          <div class="pt-3 flex justify-end space-x-2">
            <button type="button" @click="closeModal" class="px-4 py-2 border border-slate-300 rounded-lg text-slate-600 hover:bg-slate-50">取消</button>
            <button type="submit" class="px-4 py-2 bg-teal-700 text-white rounded-lg font-bold hover:bg-teal-800">儲存紀錄</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    const { createApp, ref, computed, watch, onMounted } = Vue;

    createApp({
      setup() {
        const STORAGE_KEY = 'cathay_asia_miles_titanium_txs';

        // 固定分頁控制 ('progress' | 'ledger' | 'details')
        const currentTab = ref('progress');
        
        // Modal 控制
        const showModal = ref(false);
        const isEditing = ref(false);
        const filter = ref('all');

        // 表單數據
        const form = ref({
          id: null,
          date: new Date().toISOString().split('T')[0],
          merchant: '',
          amount: null,
          isOverseas: false,
          isAccelerator: false,
          paymentMethod: 'physical'
        });

        // 交易紀錄數據 (從 localStorage 讀取或給予空陣列)
        const transactions = ref([]);

        // 初始化讀取 localStorage
        onMounted(() => {
          const savedData = localStorage.getItem(STORAGE_KEY);
          if (savedData) {
            try {
              transactions.value = JSON.parse(savedData);
            } catch (e) {
              console.error('讀取本地資料失敗:', e);
              transactions.value = [];
            }
          }
        });

        // 當 transactions 變動時自動儲存到 localStorage
        watch(transactions, (newVal) => {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(newVal));
        }, { deep: true });

        // 判斷支付方式是否有效
        const isPaymentValid = (method) => {
          return ['physical', 'apple_pay', 'google_pay', 'samsung_pay'].includes(method);
        };

        const getPaymentLabel = (method) => {
          const map = {
            physical: '實體卡刷卡',
            apple_pay: 'Apple Pay',
            google_pay: 'Google Pay',
            samsung_pay: 'Samsung Pay',
            line_pay: 'LINE Pay (第三方)',
            jko_pay: '街口支付 (第三方)',
            px_pay: '全支付/全聯',
            convenience: '便利超商',
            excluded_bills: '公務/水電/稅款'
          };
          return map[method] || method;
        };

        // 判斷是否為 8月 (壽星月份)
        const isAugust = (dateStr) => {
          if (!dateStr) return false;
          const month = new Date(dateStr).getMonth() + 1;
          return month === 8;
        };

        // 計算鈦商卡基礎哩程 (加速器 $10/里，一般消費 $25/里)
        const calcBaseMiles = (tx) => {
          if (!tx.isValidPayment) return 0;
          const rate = tx.isAccelerator ? 10 : 25;
          return Math.floor(tx.amount / rate);
        };

        // 鈦商卡基礎哩程總計
        const baseMilesTotal = computed(() => {
          return transactions.value.reduce((sum, tx) => sum + calcBaseMiles(tx), 0);
        });

        // 活動A：海外合規消費額與組數 (每滿 NT$30,000)
        const overseasValidTotal = computed(() => {
          return transactions.value
            .filter(tx => tx.isValidPayment && tx.isOverseas)
            .reduce((sum, tx) => sum + tx.amount, 0);
        });

        const overseasSteps = computed(() => {
          return Math.floor(overseasValidTotal.value / 30000);
        });

        // 活動A：國內合規消費額與組數 (每滿 NT$30,000)
        const domesticValidTotal = computed(() => {
          return transactions.value
            .filter(tx => tx.isValidPayment && !tx.isOverseas)
            .reduce((sum, tx) => sum + tx.amount, 0);
        });

        const domesticSteps = computed(() => {
          return Math.floor(domesticValidTotal.value / 30000);
        });

        // 活動A 加碼里數計算 (優先算海外1000里/組，剩餘額度算國內500里/組，上限4000)
        const activityAMiles = computed(() => {
          const rawOverseasMiles = overseasSteps.value * 1000;
          const actualOverseas = Math.min(4000, rawOverseasMiles);
          const remainingCap = 4000 - actualOverseas;
          
          const rawDomesticMiles = domesticSteps.value * 500;
          const actualDomestic = Math.min(remainingCap, rawDomesticMiles);
          
          return actualOverseas + actualDomestic;
        });

        // 好禮二星巴克解鎖資格
        const starbucksQualified = computed(() => {
          return domesticValidTotal.value >= 30000 || overseasValidTotal.value >= 30000;
        });

        // 活動B：8月生日月加速器消費額與加碼哩程 (加碼額外1倍，上限5,000里)
        const augustAcceleratorTotal = computed(() => {
          return transactions.value
            .filter(tx => tx.isValidPayment && isAugust(tx.date) && tx.isAccelerator)
            .reduce((sum, tx) => sum + tx.amount, 0);
        });

        const activityBMiles = computed(() => {
          // 生日加碼額外1倍等於加速器基礎里數
          const totalAugMiles = transactions.value
            .filter(tx => tx.isValidPayment && isAugust(tx.date) && tx.isAccelerator)
            .reduce((sum, tx) => sum + calcBaseMiles(tx), 0);
          return Math.min(5000, totalAugMiles);
        });

        // 總累積預估哩程
        const totalMiles = computed(() => {
          return baseMilesTotal.value + activityAMiles.value + activityBMiles.value;
        });

        // 記帳頁面篩選
        const filteredTransactions = computed(() => {
          return transactions.value.filter(tx => {
            if (filter.value === 'august') return isAugust(tx.date);
            if (filter.value === 'actA') return tx.isValidPayment;
            if (filter.value === 'invalid') return !tx.isValidPayment;
            return true;
          });
        });

        // Modal 操作
        const openAddModal = () => {
          isEditing.value = false;
          form.value = {
            id: Date.now(),
            date: new Date().toISOString().split('T')[0],
            merchant: '',
            amount: null,
            isOverseas: false,
            isAccelerator: false,
            paymentMethod: 'physical'
          };
          showModal.value = true;
        };

        const editTx = (tx) => {
          isEditing.value = true;
          form.value = { ...tx };
          showModal.value = true;
        };

        const closeModal = () => {
          showModal.value = false;
        };

        const saveTx = () => {
          const isValid = isPaymentValid(form.value.paymentMethod);
          const item = { ...form.value, isValidPayment: isValid };

          if (isEditing.value) {
            const index = transactions.value.findIndex(t => t.id === item.id);
            if (index !== -1) transactions.value[index] = item;
          } else {
            transactions.value.unshift(item);
          }
          closeModal();
        };

        const deleteTx = (id) => {
          if (confirm('確定要刪除這筆簽帳紀錄嗎？')) {
            transactions.value = transactions.value.filter(t => t.id !== id);
          }
        };

        const clearAllTx = () => {
          if (confirm('確定要清空所有的簽帳紀錄嗎？這項動作無法復原！')) {
            transactions.value = [];
          }
        };

        const formatNum = (num) => {
          if (!num) return '0';
          return num.toLocaleString('zh-TW');
        };

        return {
          currentTab,
          showModal,
          isEditing,
          filter,
          form,
          transactions,
          filteredTransactions,
          baseMilesTotal,
          overseasValidTotal,
          overseasSteps,
          domesticValidTotal,
          domesticSteps,
          activityAMiles,
          starbucksQualified,
          augustAcceleratorTotal,
          activityBMiles,
          totalMiles,
          isPaymentValid,
          getPaymentLabel,
          isAugust,
          calcBaseMiles,
          openAddModal,
          editTx,
          closeModal,
          saveTx,
          deleteTx,
          clearAllTx,
          formatNum
        };
      }
    }).mount('#app');
  </script>
</body>
</html>